# Supabase Auth and merchant workspace database
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Local OAuth/email callback. Add the same URL in Supabase Auth settings.
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# OpenRouter grounded merchant-data agent and fallback invoice image model
OPENROUTER_API_KEY=
OPENROUTER_AGENT_MODEL=openai/gpt-4o-mini
OPENROUTER_VISION_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://localhost:3000

# Sarvam Document AI, speech recognition and speech synthesis
SARVAM_API_KEY=
SARVAM_DOCUMENT_MODEL=sarvam-vision-v1
SARVAM_STT_MODEL=saaras:v4
TTS_PROVIDER=sarvam
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SPEAKER=shubh

# Optional outbound supplier calls. Calls require a LiveKit outbound SIP trunk and provider.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_TRUNK_ID=
LIVEKIT_AGENT_NAME=disha-supplier-caller
SARVAM_CALL_LANGUAGE=en-IN
