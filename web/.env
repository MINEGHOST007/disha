# Required for sign-in, onboarding, and persisted workspace actions.
# Copy this file to .env.local and replace the placeholders.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# # Local OAuth/email callback. Add the same URL in Supabase Auth settings.
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# # Optional LLM narration. The deterministic fallback works without these.
# LLM_PROVIDER=gateway
# GATEWAY_MODEL=google/gemini-3.8-flash
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# Uses OpenRouter's free-model router; availability changes automatically.
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_SITE_URL=http://localhost:3000

# Optional text-to-speech. Leave TTS_PROVIDER unset to use browser speech.
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_multilingual_v2
# TTS_PROVIDER=sarvam
# SARVAM_API_KEY=
# SARVAM_SPEAKER=meera
# SARVAM_TTS_MODEL=bulbul:v2




# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://zazclcrtuzttlqkwwfxk.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_2VVMSsZOTPalawMapfZqJw_Kx7XIsSm
SUPABASE_URL=https://zazclcrtuzttlqkwwfxk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_Js_9C_TAT9n8McRrfr6q4g_9WKWbh40
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# OpenRouter narration
LLM_PROVIDER=openrouter
